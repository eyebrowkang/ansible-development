# syntax=docker/dockerfile:1
# VM-track toolchain: uv + docker CLI + Vagrant + QEMU + libvirt. Used by the generated
# roles' vagrant CI job (containerized). Ships tini (a PID-1 zombie reaper) and a qemu.conf
# relaxed for in-container libvirt — see the RUN below and docs/ci-overview.md.
# See docs/ci-overview.md. Tag immutably — see .forgejo/workflows/build-image.yml.
# Bases + uv are digest-pinned so a given sha-<short> rebuilds reproducibly (tag locks
# the recipe; digests lock the product). Refresh: docker buildx imagetools inspect <img>.
FROM debian:13-slim@sha256:4e401d95de7083948053197a9c3913343cd06b706bf15eb6a0c3ccd26f436a0e

ENV DEBIAN_FRONTEND=noninteractive
# dnsmasq-base + iptables: libvirt NAT networks need them, but they're only Recommends of
# libvirt-daemon-system, which --no-install-recommends drops — that was vagrant-libvirt's
# "Unable to find 'dnsmasq' binary in $PATH" failure. Install them explicitly.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq make nodejs openssh-client shellcheck tini \
        vagrant vagrant-libvirt \
        qemu-system-x86 qemu-utils \
        libvirt-clients libvirt-daemon-system dnsmasq-base iptables \
        libvirt-dev pkg-config gcc python3-dev \
    && rm -rf /var/lib/apt/lists/*

# libvirt + qemu inside a container can't do the host-only isolation they default to, so
# relax it in the image (purpose-built for containerized CI): cgroup_controllers=[] avoids
# the "/sys/fs/cgroup/machine/..." create failure, namespaces=[] skips per-VM mount
# namespaces, security_driver=none skips AppArmor, user/group=root avoids qemu perm issues.
RUN printf '%s\n' \
        'security_driver = "none"' \
        'user = "root"' \
        'group = "root"' \
        'cgroup_controllers = []' \
        'namespaces = []' \
      >> /etc/libvirt/qemu.conf

COPY --from=docker:29-cli@sha256:cdfd70216347d3cbc202a64752101dd76d11f87396749c33641eb487e2e9effc /usr/local/bin/docker /usr/local/bin/docker
COPY --from=ghcr.io/astral-sh/uv:0.11@sha256:ff07b86af50d4d9391d9daf4ff89ce427bc544f9aae87057e69a1cc0aa369946 /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy
RUN uv python install 3.13.14

LABEL org.opencontainers.image.title="ansible-builder-vagrant"
