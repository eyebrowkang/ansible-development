# syntax=docker/dockerfile:1
# VM-track toolchain: uv + docker CLI + Vagrant + QEMU + libvirt. Only needed if your
# libvirt runner is containerized (the default vagrant CI job runs host-mode instead).
# See docs/ci-overview.md. Tag immutably — see .forgejo/workflows/build-image.yml.
FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git make nodejs openssh-client shellcheck \
        vagrant \
        qemu-system-x86 qemu-utils \
        libvirt-clients libvirt-daemon-system \
        libvirt-dev pkg-config gcc python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && vagrant plugin install vagrant-libvirt

COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy
RUN uv python install 3.13

LABEL org.opencontainers.image.title="ansible-builder-vagrant"
