---
name: CI
on: [push, pull_request]

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - run: uv run yamllint .
      - run: uv run ansible-lint
{% if shell_templates %}
      - name: Render templates and run shellcheck
        run: |
          sudo apt-get update && sudo apt-get install -y shellcheck
          uv run bash tests/shellcheck.sh
{% endif %}

  molecule-docker:
    runs-on: ubuntu-latest
    needs: lint
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - name: Molecule (docker)
        run: uv run molecule test
      - name: Destroy
        if: always()
        run: uv run molecule destroy
