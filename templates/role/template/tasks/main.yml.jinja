---
# tasks for {{ namespace }}.{{ role_name }}
#
# Placeholder that manages ONE file, so `converge` has a real, idempotent effect that
# molecule's `idempotence` step and verify.yml can check. The destination comes from a
# role variable (declared in defaults/main.yml + validated in meta/argument_specs.yml).
# Replace with your role's real tasks — and keep them idempotent (re-running must report
# no changes).
- name: Ensure the role marker file is present
  ansible.builtin.copy:
    content: "{{ namespace }}.{{ role_name }} applied\n"
    dest: "{{ '{{ ' ~ role_name ~ '_marker_path }}' }}"
    owner: root
    group: root
    mode: "0644"
