---
name: molecule
on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
{% if include_docker %}
  docker:
    # Container job; the Forgejo runner's automounted docker.sock (DooD) lets molecule
    # create the instance on the host daemon. systemd config lives in molecule.yml.
    runs-on: ubuntu-latest
    container:
      image: {{ builder_registry }}/ansible-builder:{{ builder_tag }}
    steps:
      - uses: actions/checkout@v4
      - run: uv sync
      - name: Molecule (docker)
        run: uv run molecule test
      - name: Destroy
        if: always()
        run: uv run molecule destroy
{% endif %}
{% if include_docker and include_vagrant %}

{% endif %}
{% if include_vagrant %}
  vagrant:
    # Containerized vagrant track: the job runs in the ansible-builder-vagrant image with
    # --privileged so it can reach /dev/kvm and run libvirtd inside the container (this
    # runner runs every job in Docker; nothing is installed on the host). The image ships
    # uv, so there's no setup-uv step. Host-mode is the alternative — see docs/ci-overview.md.
    runs-on: [self-hosted, kvm]
    timeout-minutes: 30   # a stuck VM teardown shouldn't burn the runner for hours
    container:
      image: {{ builder_registry }}/ansible-builder-vagrant:{{ builder_tag }}
      # Forgejo's container.options only honors --volume/--tmpfs/--hostname/--memory — NOT
      # --privileged/--device. This job needs /dev/kvm + privilege, so the *runner* must be
      # configured privileged (the same privileged DooD runner). See docs/ci-overview.md.
    steps:
      - uses: actions/checkout@v4
      - name: Start libvirt daemons
        # Run libvirtd under tini's subreaper mode so the qemu libvirt daemonizes gets reaped
        # — act's container PID 1 (`tail`) never reaps zombies, so otherwise `vagrant destroy`
        # hangs. tini + the relaxed qemu.conf are baked into ansible-builder-vagrant (needs
        # builder image >= v1.2.0). See docs/ci-overview.md.
        run: |
          virtlogd -d
          setsid tini -s -- libvirtd >/tmp/libvirtd.log 2>&1 &
          for i in $(seq 30); do virsh -c qemu:///system version >/dev/null 2>&1 && break; sleep 1; done
      - run: uv sync --group vagrant
      - name: Molecule (vagrant)
        run: make test-vm
      - name: Destroy
        if: always()
        run: make destroy-vm   # same #301 env workaround as test-vm
{% endif %}
