---
name: lint
on: [push, pull_request]

jobs:
  lint:
    runs-on: ubuntu-latest
    container:
      image: {{ builder_registry }}/ansible-builder:{{ builder_tag }}
    steps:
      - uses: actions/checkout@v4
      - run: uv sync
      - run: uv run ansible-galaxy collection install -r molecule/default/collections.yml
      - run: uv run yamllint .
      - run: uv run ansible-lint
{% if shell_templates %}
      - name: Render templates and run shellcheck
        run: uv run bash tests/shellcheck.sh
{% endif %}
