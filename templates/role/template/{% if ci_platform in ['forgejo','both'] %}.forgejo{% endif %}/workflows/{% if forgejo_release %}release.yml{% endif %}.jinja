---
name: release
# Tag-driven release for self-hosted Forgejo roles (not published to Galaxy).
# Push a v* tag -> git-cliff builds release notes + CHANGELOG.md, then a Forgejo release
# is created via the API using the auto-provided token (no extra secret needed).
on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    container:
      image: {{ builder_registry }}/ansible-builder:{{ builder_tag }}
{% raw %}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # git-cliff needs full history + tags

      - name: Install git-cliff
        run: |
          ver=2.13.1
          mkdir -p /tmp/gc
          curl -fsSL "https://github.com/orhun/git-cliff/releases/download/v${ver}/git-cliff-${ver}-x86_64-unknown-linux-musl.tar.gz" \
            | tar -xz -C /tmp/gc --strip-components=1
          install /tmp/gc/git-cliff /usr/local/bin/git-cliff

      - name: Build release notes for this tag
        run: git-cliff --latest --strip header -o RELEASE_NOTES.md

      - name: Create the Forgejo release
        run: |
          jq -n --arg tag "$GITHUB_REF_NAME" --rawfile body RELEASE_NOTES.md \
            '{tag_name: $tag, name: $tag, body: $body, draft: false, prerelease: false}' \
          | curl -fsSL -X POST \
              "$GITHUB_SERVER_URL/api/v1/repos/$GITHUB_REPOSITORY/releases" \
              -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
              -H "Content-Type: application/json" \
              --data @-

      # Keep CHANGELOG.md on the default branch in sync. Delete this step if you maintain
      # CHANGELOG.md locally or the default branch rejects direct pushes.
      - name: Sync CHANGELOG.md on the default branch
        run: |
          git config --global --add safe.directory "$(pwd)"
          default="${{ github.event.repository.default_branch }}"
          default="${default:-main}"
          git config user.name "forgejo-actions"
          git config user.email "forgejo-actions@noreply.local"
          git fetch origin "$default"
          git checkout -B "$default" FETCH_HEAD
          git-cliff -o CHANGELOG.md
          git add CHANGELOG.md
          git diff --cached --quiet || {
            git commit -m "chore(changelog): $GITHUB_REF_NAME [skip ci]"
            git push origin "HEAD:$default"
          }
{% endraw %}
