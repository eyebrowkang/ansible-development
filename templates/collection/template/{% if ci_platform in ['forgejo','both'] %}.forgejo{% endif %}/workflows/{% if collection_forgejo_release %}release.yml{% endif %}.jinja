---
name: release
# Tag-driven Forgejo release (self-hosted; not published to Galaxy). Push a vX.Y.Z tag
# and this, on the default branch: bumps galaxy.yml, folds changelogs/fragments/ into
# CHANGELOG.md via antsibull-changelog, builds the collection tarball, creates a Forgejo
# release with the tarball attached, and commits the bump + changelog back. Uses the
# auto-injected GITHUB_TOKEN; no extra secret. If the default branch is protected, drop
# the final commit step and bump + `make changelog` locally before tagging instead.
on:
  push:
    tags:
      - 'v*'

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    container:
      image: {{ builder_registry }}/ansible-builder:{{ builder_tag }}
{% raw %}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0   # full history + tags for antsibull-changelog
      - name: Check out the default branch (release commit lands here)
        run: |
          git config --global --add safe.directory "$(pwd)"
          default="${{ github.event.repository.default_branch }}"
          default="${default:-main}"
          git config user.name "forgejo-actions"
          git config user.email "forgejo-actions@noreply.local"
          git fetch origin "$default"
          git checkout -B "$default" FETCH_HEAD
          echo "DEFAULT_BRANCH=$default" >> "$GITHUB_ENV"
      - run: uv sync
      - name: Bump galaxy.yml version + render changelog
        run: |
          version="${GITHUB_REF_NAME#v}"
          sed -i "s/^version:.*/version: ${version}/" galaxy.yml
          uv run antsibull-changelog release --version "${version}"
      - name: Build the collection
        run: uv run ansible-galaxy collection build --output-path dist

      - name: Create the Forgejo release + upload the tarball
        run: |
          tarball="$(ls dist/*.tar.gz)"
          rel_id="$(jq -n --arg tag "$GITHUB_REF_NAME" \
              '{tag_name: $tag, name: $tag, body: ("Released " + $tag + ". See CHANGELOG.md."), draft: false, prerelease: false}' \
            | curl -fsSL -X POST \
                "$GITHUB_SERVER_URL/api/v1/repos/$GITHUB_REPOSITORY/releases" \
                -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
                -H "Content-Type: application/json" --data @- \
            | jq -r '.id')"
          curl -fsSL -X POST \
            "$GITHUB_SERVER_URL/api/v1/repos/$GITHUB_REPOSITORY/releases/$rel_id/assets?name=$(basename "$tarball")" \
            -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
            -F "attachment=@${tarball}"

      - name: Commit version bump + changelog
        run: |
          git add galaxy.yml CHANGELOG.md changelogs/changelog.yaml changelogs/fragments
          git diff --cached --quiet || git commit -m "chore(release): $GITHUB_REF_NAME [skip ci]"
          git push origin "HEAD:$DEFAULT_BRANCH"
{% endraw %}
