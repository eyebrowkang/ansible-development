---
name: release
# Tag-driven Forgejo release (self-hosted; not published to Galaxy).  Prepare the
# release commit first: bump galaxy.yml, run `make changelog`, commit, then push a
# plain SemVer tag such as 0.2.2.  A release tag is immutable: this workflow checks
# out and builds that exact tag and never writes a branch or moves a tag.
on:
  push:
    tags:
      - '[0-9]*'

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    container:
      image: {{ builder_registry }}/ansible-builder:{{ builder_tag }}
{% raw %}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.ref }}
          fetch-depth: 0
      - name: Verify immutable release input
        run: |
          git config --global --add safe.directory "$(pwd)"
          version="$GITHUB_REF_NAME"
          printf '%s' "$version" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)*$' \
            || { echo "::error::tag '$version' is not a plain SemVer X.Y.Z[-pre][+build]"; exit 1; }
          metadata_version="$(awk '/^version:/ { print $2; exit }' galaxy.yml)"
          [ "$metadata_version" = "$version" ] \
            || { echo "::error::tag '$version' does not match galaxy.yml version '$metadata_version'"; exit 1; }
          [ "$(git describe --exact-match --tags HEAD)" = "$version" ] \
            || { echo "::error::HEAD is not exactly tag '$version'"; exit 1; }
      - run: uv sync
      - name: Build the collection from the release tag
        run: |
          uv run ansible-galaxy collection build --output-path dist

      - name: Create the Forgejo release + upload the tarball
        run: |
          tarball="$(ls dist/*.tar.gz)"
          version="$GITHUB_REF_NAME"
          # Use the release_summary from the changelog (may be non-English) as the
          # release body; fall back to a short pointer if it can't be read.
          body="$(uv run python -c '
          import sys

          import yaml

          version = sys.argv[1]
          with open("changelogs/changelog.yaml", encoding="utf-8") as changelog:
              data = yaml.safe_load(changelog)

          print(
              data.get("releases", {})
              .get(version, {})
              .get("changes", {})
              .get("release_summary", "")
          )
          ' "$version" 2>/dev/null || true)"
          [ -n "$body" ] || body="已发布 ${GITHUB_REF_NAME},详见 CHANGELOG.md。"
          rel_id="$(jq -n --arg tag "$GITHUB_REF_NAME" --arg body "$body" \
              '{tag_name: $tag, name: $tag, body: $body, draft: false, prerelease: false}' \
            | curl -fsSL -X POST \
                "$GITHUB_SERVER_URL/api/v1/repos/$GITHUB_REPOSITORY/releases" \
                -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
                -H "Content-Type: application/json" --data @- \
            | jq -r '.id')"
          [ -n "$rel_id" ] && [ "$rel_id" != null ] || { echo "::error::release creation returned no id"; exit 1; }
          curl -fsSL -X POST \
            "$GITHUB_SERVER_URL/api/v1/repos/$GITHUB_REPOSITORY/releases/$rel_id/assets?name=$(basename "$tarball")" \
            -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
            -F "attachment=@${tarball}"
{% endraw %}
