---
name: renovate
# Self-hosted Renovate for the Forgejo track (self-hosted Forgejo has no hosted Renovate
# App). Runs weekly + on demand and opens dependency-update PRs for uv (pyproject.toml +
# uv.lock) and Actions, per renovate.json. renovatebot/github-action runs Renovate through
# the runner's automounted docker.sock (DooD) — the same sibling-container model molecule uses.
#
# Secrets to configure (repo → Settings → Actions → Secrets):
#   RENOVATE_TOKEN            — a Forgejo access token for a bot user with this repo's
#                               read/write + pull-request scope (REQUIRED).
#   RENOVATE_GITHUB_COM_TOKEN — a read-only github.com PAT (optional) so Renovate can fetch
#                               release notes / Action versions without hitting GitHub's
#                               anonymous API rate limit.
on:
  schedule:
    - cron: '0 6 * * 1'   # weekly: Monday 06:00 UTC
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  renovate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Check RENOVATE_TOKEN is set
        id: guard
        env:
          RENOVATE_TOKEN: ${{ secrets.RENOVATE_TOKEN }}
        run: |
          if [ -z "$RENOVATE_TOKEN" ]; then
            echo "::warning::RENOVATE_TOKEN not set — skipping Renovate. Set it (a Forgejo bot token with repo read/write + PR) to enable dependency updates."
            echo "run=false" >> "$GITHUB_OUTPUT"
          else
            echo "run=true" >> "$GITHUB_OUTPUT"
          fi
      - name: Run Renovate
        if: ${{ steps.guard.outputs.run == 'true' }}
        uses: https://github.com/renovatebot/github-action@v46.1.15
        env:
          # Forgejo is its own Renovate platform (the legacy 'gitea' platform will drop
          # Forgejo support). github.* is aliased to forgejo.* on the runner.
          RENOVATE_PLATFORM: forgejo
          # Forgejo API base. github.server_url is aliased to the Forgejo host; the API
          # lives at /api/v1 (same base the release workflows build from $GITHUB_SERVER_URL).
          RENOVATE_ENDPOINT: ${{ github.server_url }}/api/v1
          RENOVATE_TOKEN: ${{ secrets.RENOVATE_TOKEN }}
          RENOVATE_REPOSITORIES: ${{ github.repository }}
          RENOVATE_GITHUB_COM_TOKEN: ${{ secrets.RENOVATE_GITHUB_COM_TOKEN }}
          LOG_LEVEL: info
