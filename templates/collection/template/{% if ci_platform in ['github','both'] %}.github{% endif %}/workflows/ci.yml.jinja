---
name: CI
on: [push, pull_request]

defaults:
  run:
    # ansible-test must run from ansible_collections/<ns>/<name>/; check out there and
    # run everything from that path (also keeps ansible-lint collection-aware).
    working-directory: ansible_collections/{{ namespace }}/{{ collection_name }}

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          path: ansible_collections/{{ namespace }}/{{ collection_name }}
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - run: uv run ansible-galaxy collection install -r extensions/molecule/default/collections.yml
      - run: uv run yamllint .
      - run: uv run ansible-lint

  sanity:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          path: ansible_collections/{{ namespace }}/{{ collection_name }}
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - name: ansible-test sanity
        run: uv run ansible-test sanity --venv --color

  molecule:
    runs-on: ubuntu-latest
    needs: lint
    steps:
      - uses: actions/checkout@v4
        with:
          path: ansible_collections/{{ namespace }}/{{ collection_name }}
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - name: Molecule (example role)
        run: uv run molecule test
      - name: Destroy
        if: always()
        run: uv run molecule destroy
