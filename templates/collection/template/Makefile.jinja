# Local dev targets (mirror CI). Requires uv: https://docs.astral.sh/uv/
.PHONY: help install deps lint sanity{% if include_plugins %} units{% endif %}{% if collection_release or collection_forgejo_release %} changelog{% endif %}{% if include_docker %} test converge destroy{% endif %}{% if include_vagrant %} test-vm destroy-vm{% endif %}

help:
	@echo "install   - uv sync (dev toolchain)"
	@echo "lint      - yamllint + ansible-lint"
	@echo "deps      - install Galaxy collections that ansible-lint needs"
	@echo "sanity    - ansible-test sanity (--venv, no docker)"
{% if include_plugins %}	@echo "units     - ansible-test units (plugin unit tests, --venv)"
{% endif %}{% if collection_release or collection_forgejo_release %}	@echo "changelog - antsibull-changelog release (fold fragments; bump galaxy.yml first)"
{% endif %}{% if include_docker %}	@echo "test      - molecule test for the example role (docker)"
	@echo "converge  - molecule converge (example role, docker)"
	@echo "destroy   - molecule destroy (example role, docker)"
{% endif %}{% if include_vagrant %}	@echo "test-vm    - molecule test (example role, vagrant; needs 'uv sync --group vagrant' + libvirt/KVM)"
	@echo "destroy-vm - molecule destroy (example role, vagrant)"
{% endif %}

install:
	uv sync

# ansible-lint resolves the molecule scenario's collections (community.docker for the
# docker scenario's create.yml) from the Galaxy install path, so install them first —
# the same step CI runs before linting. molecule's own test sequence installs these via
# dependency:galaxy.
deps:
	uv run ansible-galaxy collection install -r extensions/molecule/{% if include_docker %}default{% else %}vagrant{% endif %}/collections.yml

lint: deps
	uv run yamllint .
	uv run ansible-lint

# ansible-test must run from within ansible_collections/<ns>/<name>/ — which this
# directory's path already satisfies in the workspace. --venv isolates the sanity
# test deps in their own venv (no docker needed; works under the Forgejo DooD runner,
# where --docker's sibling-container bind mounts would miss the checked-out collection).
sanity:
	uv run ansible-test sanity --venv --color
{% if include_plugins %}
# Plugin unit tests under tests/unit/ (--venv, no docker; runs from the collection path).
units:
	uv run ansible-test units --venv --color
{% endif %}{% if collection_release or collection_forgejo_release %}
# Fold changelogs/fragments/*.yml into changelogs/changelog.yaml + regenerate CHANGELOG.md.
# Bump galaxy.yml's version first (or the v* tag release workflow does both in CI).
changelog:
	uv run antsibull-changelog release
{% endif %}{% if include_docker %}
# The collection-level molecule scenario converges the example role by its short name
# (molecule.yml sets ANSIBLE_ROLES_PATH to roles/). Add more scenarios under molecule/.
test:
	uv run molecule test

converge:
	uv run molecule converge

destroy:
	uv run molecule destroy
{% endif %}{% if include_vagrant %}
# molecule-plugins#301: the vagrant module/filter aren't on Ansible's default search
# path. Compute the package paths at runtime (no hardcoded python version) and export
# them so molecule can find the vagrant module. See docs/molecule-301-workaround.md
test-vm:
	ANSIBLE_LIBRARY="$$(uv run python -c 'import os, molecule_plugins.vagrant as m; print(os.path.join(os.path.dirname(m.__file__), "modules"))')" \
	ANSIBLE_FILTER_PLUGINS="$$(uv run python -c 'import os, molecule as m; print(os.path.join(os.path.dirname(m.__file__), "provisioner", "ansible", "plugins", "filter"))')" \
	uv run molecule test -s vagrant

# Cleanup for the vagrant scenario — same molecule-plugins#301 env workaround as test-vm.
destroy-vm:
	ANSIBLE_LIBRARY="$$(uv run python -c 'import os, molecule_plugins.vagrant as m; print(os.path.join(os.path.dirname(m.__file__), "modules"))')" \
	ANSIBLE_FILTER_PLUGINS="$$(uv run python -c 'import os, molecule as m; print(os.path.join(os.path.dirname(m.__file__), "provisioner", "ansible", "plugins", "filter"))')" \
	uv run molecule destroy -s vagrant
{% endif %}
