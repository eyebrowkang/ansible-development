---
namespace: {{ namespace }}
name: {{ collection_name }}
version: 0.1.0
readme: README.md
authors:
  - {{ author | tojson }}
description: {{ (collection_description or collection_name) | tojson }}
{% if license != 'none' %}
license:
  - {{ license }}
{% endif %}
{% set repository_url = (forgejo_url if ci_platform == 'forgejo' else 'https://github.com') ~ '/' ~ namespace ~ '/ansible-collection-' ~ collection_name %}
# Update these URLs to your real repository (Galaxy requires `repository`).
repository: {{ repository_url }}
homepage: {{ repository_url }}
issues: {{ repository_url }}/issues
{% if collection_tags %}
tags:
{% for t in collection_tags %}
  - {{ t }}
{% endfor %}
{% else %}
tags: []
{% endif %}
{% if collection_dependencies %}
dependencies:
{% for dep_name, dep_version in collection_dependencies.items() %}
  {{ dep_name }}: "{{ dep_version }}"
{% endfor %}
{% else %}
dependencies: {}
{% endif %}
# Keep dev/CI scaffolding out of the built collection artifact.
build_ignore:
  - .git
  - .gitignore
  - .github
  - .forgejo
  - .venv
  - .ansible
  - .copier-answers.yml
  - extensions
{% if include_plugins or include_unit_tests %}
  # Unit tests wired: ship tests/ (unit tests + any sanity ignore files) so consumers can
  # run them; exclude only the generated ansible-test output.
  - tests/output
{% else %}
  # roles-only collection ships nothing under tests/; it only ever holds the generated
  # ansible-test `tests/output/` artifact. include_unit_tests narrows this to tests/output.
  - tests
{% endif %}
  - pyproject.toml
  - uv.lock
  - Makefile
  - .pre-commit-config.yaml
  - .ansible-lint
  - .yamllint.yml
  - .python-version
  - renovate.json
